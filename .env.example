# API auth: when set, every runtime and knowledge route needs `Authorization: Bearer <key>` (health excepted)
YACHAT_API_KEY=
# A key per tenant: it reaches only that tenant, in the API, the console and the /mcp endpoint (Claude plugin).
# YACHAT_TENANT_KEYS=acme:change-me,globex:change-me-too
# Host names /mcp accepts; unset: the key alone guards it.
# YACHAT_MCP_ALLOWED_HOSTS=chatter.example.com

# Model (required): anthropic | litellm
YACHAT_LLM=litellm
# Optional LiteLLM gateway: when set, every model call goes to the proxy (OpenAI-compatible) and
# YACHAT_MODEL_* are the aliases configured there; the gateway owns routing, fallbacks and cost logging
LITELLM_PROXY_URL=
LITELLM_PROXY_KEY=
# Optional Headroom proxy in front of the gateway (context compression): `docker compose --profile gateway up -d`
# starts both on :8788 (headroom) and :4000 (litellm); then set HEADROOM_PROXY_URL=http://127.0.0.1:8788 and
# LITELLM_PROXY_URL=http://127.0.0.1:4000 with YACHAT_MODEL_GENERATE=large, YACHAT_MODEL_CLASSIFY=small
HEADROOM_PROXY_URL=
ANTHROPIC_API_KEY=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
OPENROUTER_API_KEY=
OPENAI_API_KEY=
YACHAT_MODEL_GENERATE=siliconflow/Qwen/Qwen3.5-35B-A3B
YACHAT_MODEL_CLASSIFY=siliconflow/Qwen/Qwen3.5-35B-A3B
# Verifies analytics and knowledge answers before they are shown (yachat/reasoning). Empty: the generate model.
# A different model makes the check more independent.
YACHAT_MODEL_VERIFY=
EVALS_JUDGE_MODEL=

# Tool backends. A tool whose URL is unset raises on first call; YACHAT_TOOLS=fake (development only, set by
# scripts/dev.sh --fake-tools) substitutes FakeTools for exactly those tools.
JOB_SEARCH_URL=
KNOWLEDGE_URL=
ANALYTICS_URL=
CAREER_URL=
# Human handoff: handoffs always land in the platform inbox; a policy with `handoff: {notify: handoff_webhook}` also
# POSTs each one here. HANDOFF_TOKEN is sent as a bearer token.
HANDOFF_URL=
HANDOFF_TOKEN=
# User memory in mem0 instead of Postgres. Hosted: MEM0_API_KEY (MEM0_ORG_ID, MEM0_PROJECT_ID optional). Self-hosted on
# Qdrant: MEM0_QDRANT_URL (+ MEM0_QDRANT_API_KEY) or MEM0_QDRANT_PATH (embedded), embeddings from SiliconFlow. Every memory
# is scoped to workspace + user + agent; mem0 never infers memories itself (only policy-listed items, after consent).
MEM0_API_KEY=
MEM0_QDRANT_URL=
MEM0_QDRANT_PATH=
# Sentry (the free Developer plan is enough): errors and performance traces per stage and model call. No message text,
# prompts, replies or request bodies are sent. Sample rate: share of requests traced (default 0.1).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
# The public address of this server: phone-call webhooks are signed against it, and links point at it.
YACHAT_PUBLIC_URL=
TWILIO_AUTH_TOKEN=          # phone calls: checks Twilio's webhook signatures
# Voice. Speech to text: whisper-1, groq/whisper-large-v3-turbo, or an audio chat model like
# openrouter/google/gemini-2.5-flash-lite. Speech: openai/tts-1 (voice alloy), elevenlabs (+ ELEVENLABS_API_KEY, voice id),
# or a model on VOICE_TTS_BASE_URL (SiliconFlow: openai/fishaudio/fish-speech-1.5, voice fishaudio/fish-speech-1.5:alex).
# Unset: the browser's own speech recognition and voice. Phone calls need TWILIO_AUTH_TOKEN (webhook signatures).
VOICE_STT_MODEL=
VOICE_TTS_MODEL=
VOICE_TTS_VOICE=
VOICE_TTS_BASE_URL=
VOICE_TTS_API_KEY=
# Uploaded content (chatbots built from files): an S3 bucket (also list it in YACHAT_DATA_BUCKETS so the Knowledge
# Service may read it), else a folder under YACHAT_DATA_ROOT.
YACHAT_UPLOADS_BUCKET=

YACHAT_UNPRICED_USD_PER_MTOK=15  # charged against a limit per million tokens when a model has no known price
YACHAT_JWT_SECRET=                # 32+ chars: new API keys are signed JWTs (tenant, scope, expiry); unset: opaque keys
# Signs website-widget conversation tokens (also encrypts stored WhatsApp credentials); set it so widget chats survive restarts and work across replicas.
YACHAT_EMBED_SECRET=
# Postgres connections per process, shared by every store (default 1 / 10).
DATABASE_POOL_MIN=
DATABASE_POOL_MAX=
# Model effort (low / medium / high) for generating, classifying and rephrasing replies.
YACHAT_EFFORT_GENERATE=
YACHAT_EFFORT_CLASSIFY=
YACHAT_EFFORT_REWRITE=
# Days audit records are kept (default 90).
AUDIT_RETENTION_DAYS=
# Archive audit records to Apache Iceberg (Parquet on S3, catalog in Postgres), exported hourly. Install the `audit`
# extra. Catalog: AUDIT_ARCHIVE_CATALOG_URI (SQLAlchemy URI), else DATABASE_URL. Postgres keeps AUDIT_HOT_DAYS (7).
AUDIT_ARCHIVE_WAREHOUSE=
AUDIT_ARCHIVE_CATALOG_URI=
AUDIT_HOT_DAYS=
# Model prices for cost tracking, USD per million input and output tokens, e.g. {"siliconflow/Qwen/Qwen3.5-35B-A3B": [0.1, 0.4]}.
# Unset: OpenRouter's public prices (fetched daily), then litellm's; unknown models show tokens without a cost.
YACHAT_MODEL_PRICES=
# off: don't fetch OpenRouter prices.
YACHAT_OPENROUTER_PRICES=

# Extra capabilities: Python packages to import, and MCP servers (alias=url or alias=command) whose tools register as <alias>.<tool>
YACHAT_CAPABILITY_PACKAGES=
YACHAT_MCP_SERVERS=

# Knowledge Service
KNOWLEDGE_STRATEGY=simple
KNOWLEDGE_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
KNOWLEDGE_S3_BUCKET=
KNOWLEDGE_S3_PREFIX=knowledge/docs/
# The vector index. Unset with a bucket: s3://<bucket>/knowledge/index (beside the documents), shared by every
# Knowledge Service server. Unset without one: in memory. Or a local path.
KNOWLEDGE_INDEX_URI=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Datasets: where registered sources may live (checked by the service that reads them: Knowledge or Analytics)
YACHAT_DATA_ROOT=
YACHAT_DATA_BUCKETS=
YACHAT_MAX_TABLE_BYTES=

# Analytics Service (`scripts/analytics.sh`): answer caps and the sandbox for statistics code.
# YACHAT_SANDBOX: unset = SQL answers only | local (llm-sandbox; backend bubblewrap on Linux, docker or podman
# with the deploy/sandbox image) | agentcore (AWS Bedrock AgentCore Code Interpreter; AWS_REGION and credentials)
ANALYTICS_ROW_CAP=200
ANALYTICS_MAX_REPAIRS=3
ANALYTICS_QUERY_TIMEOUT_S=20
ANALYTICS_CODE_TIMEOUT_S=60
YACHAT_SANDBOX=
YACHAT_SANDBOX_BACKEND=
YACHAT_SANDBOX_IMAGE=
YACHAT_AGENTCORE_INTERPRETER=

# Stores (unset → in-memory). `scripts/db.sh up` starts both in Docker with exactly these URLs:
# REDIS_URL=redis://127.0.0.1:6379/0
# DATABASE_URL=postgresql://yachat:yachat@127.0.0.1:5432/yachat
REDIS_URL=
DATABASE_URL=
